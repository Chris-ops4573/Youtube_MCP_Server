# Copy to .env and fill in. Never commit .env.
# Get a key: Google Cloud Console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=your-api-key-here

# youtube (default, live API) or fixture (sample data, no quota)
YTMCP_PROVIDER=youtube

# SQLite cache (default .cache/ytmcp.db). Set YTMCP_CACHE=off to disable.
# YTMCP_CACHE_PATH=.cache/ytmcp.db
# YTMCP_CACHE=on

# Google sign-in (OAuth), only needed for features that use your own YouTube data.
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials ->
# OAuth client ID -> Application type "Desktop app". Add yourself as a test user.
# YTMCP_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# YTMCP_OAUTH_CLIENT_SECRET=your-client-secret
